{
  "name": "Orbit",
  "description": "Base Level Extension",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": ["sidePanel"],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_icon": "icons.svg"
  },
  "background": {
    "service_worker": "background.js"
  }
}
